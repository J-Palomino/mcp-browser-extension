{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/config/*": ["./lib/config/*"],
      "@repo/utils": ["./lib/utils/index"],
      "@repo/messaging/*": ["./lib/messaging/*"],
      "@repo/types/*": ["./lib/types/*"],
      "@r2r/messaging/*": ["./lib/messaging/*"]
    }
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "extension/**/*.ts"],
  "exclude": ["node_modules"]
}
